# Copy to `.env` (gitignored) and fill in. Needed only by `ubc script sync-jama`,
# which acquires the system requirements from Jama — the build itself never talks
# to Jama, because docs/alm/needs.json is committed.
#
# Jama Cloud API credentials are an OAuth client id + secret pair. Generate them
# in the Jama UI under your user profile -> Set API Credentials. `oauth = true`
# in [ubconnect.from_jama] (docs/ubproject.toml) is what makes ubConnect send
# them that way.

JAMA_USERNAME=<oauth client id>
JAMA_PASSWORD=<oauth client secret>
