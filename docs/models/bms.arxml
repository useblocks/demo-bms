<?xml version="1.0" encoding="UTF-8"?>
<!--
  BMS application software architecture, AUTOSAR classic platform R4.x.

  This file is the EXPORT of the AUTOSAR authoring tool, which stays the master
  of the software components, ports and interfaces. The repository never edits
  it; `ubc script import-models` reads it and turns every component and interface
  into a read-only need, linked to the architecture element it realizes.

  The link lives HERE, in the model, as a special data group on each component:
    <SDG GID="useblocks.Traceability"><SD GID="realizes">ARCH_...</SD></SDG>
  SDGs are the place the AUTOSAR standard defines for tool-specific data.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>BMS</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>PortInterfaces</SHORT-NAME>
          <ELEMENTS>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>CellMeasurements_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Validated cell voltages and cell temperatures, one sample per 10 ms cycle.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>cellVoltages_mV</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>cellTemperatures_dC</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/sint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>measurementValid</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PackVoltage_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Pack voltage as the sum of the validated cell voltages.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>packVoltage_mV</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PackCurrent_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Signed pack current, discharge positive, sampled at 1 ms.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>packCurrent_mA</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/sint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>currentValid</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>OvercurrentCondition_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Debounced overcurrent condition after the 100 ms persistence window.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>overcurrentActive</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>ContactorCommand_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Open command from the safety supervisor to the contactor drivers.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>openCommand</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>ProtectionFault_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Latched cell-protection fault with the cell, the limit and the measured value.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>faultActive</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>cellId</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>limitId</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>measuredValue</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/sint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>IsolationStatus_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Isolation resistance per volt of pack voltage and the derived isolation fault.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>isolation_OhmPerVolt</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>isolationFault</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>ChargeIntegral_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Charge integral of the pack current in ampere-seconds.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>charge_As</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/sint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>StateOfCharge_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Fused state-of-charge estimate in per mille of rated capacity.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>soc_permille</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>RemainingCapacity_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Remaining capacity of the pack; never increases over the life of the pack.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>capacity_mAh</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>EstimateValidity_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Trustworthiness verdict for the state-of-charge estimate.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>estimateReliable</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>BatteryState_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Vehicle-facing battery state frame, sent on a 100 ms cycle.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>soc_permille</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>capacity_mAh</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>stateValid</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>ThermalState_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Highest and lowest valid cell temperature and their spread.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>highestCellTemp_dC</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/sint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>lowestCellTemp_dC</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/sint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>spread_dK</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint16</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>ThermalRequest_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Cooling and heating request to the coolant pump and the pack heater.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>coolingRequest</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>heatingRequest</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/boolean</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>requestId</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint8</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
            <SENDER-RECEIVER-INTERFACE>
              <SHORT-NAME>PowerLimit_I</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Permitted discharge power after thermal derating.</L-2>
              </DESC>
              <IS-SERVICE>false</IS-SERVICE>
              <DATA-ELEMENTS>
                <VARIABLE-DATA-PROTOTYPE>
                  <SHORT-NAME>permittedDischargePower_W</SHORT-NAME>
                  <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/AUTOSAR_Platform/ImplementationDataTypes/uint32</TYPE-TREF>
                </VARIABLE-DATA-PROTOTYPE>
              </DATA-ELEMENTS>
            </SENDER-RECEIVER-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>
        <AR-PACKAGE>
          <SHORT-NAME>SwComponentTypes</SHORT-NAME>
          <ELEMENTS>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>CellMeasurementAcq</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Reads all cell voltages and temperatures from the analogue front-end every 10 ms.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_CELL_MEASUREMENT_ACQ</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>CellMeasurements</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/CellMeasurements_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PackVoltage</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/PackVoltage_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>CurrentPathMonitor</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Samples the shunt amplifier at 1 ms and debounces the overcurrent condition over 100 ms.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_CURRENT_PATH_MONITOR</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>PackCurrent</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/PackCurrent_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>OvercurrentCondition</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/OvercurrentCondition_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SafetySupervisor</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Single decision point of cell protection: evaluates limits, latches the fault, commands the contactors open.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_SAFETY_SUPERVISOR</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>ContactorCommand</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/ContactorCommand_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>ProtectionFault</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/ProtectionFault_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>CellMeasurements</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/CellMeasurements_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>OvercurrentCondition</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/OvercurrentCondition_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>ContactorActuator</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Drives the two contactor coils as a dual-channel low-side pair.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_CONTACTOR_ACTUATOR</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>ContactorCommand</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/ContactorCommand_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>FaultMemory</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Stores cell-protection fault records in a non-volatile ring of 64 entries.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_FAULT_MEMORY</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>ProtectionFault</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/ProtectionFault_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>IsolationMonitor</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Reduces the insulation measurement and the pack voltage to ohm per volt and derives the isolation fault.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_ISOLATION_MONITOR</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>IsolationStatus</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/IsolationStatus_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>PackVoltage</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/PackVoltage_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>CoulombCounter</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Integrates the signed pack current on a 10 ms tick.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_COULOMB_COUNTER</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>ChargeIntegral</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/ChargeIntegral_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>PackCurrent</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/PackCurrent_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>OcvCorrector</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Anchors the state of charge on the open-circuit voltage after 30 minutes of rest.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_OCV_CORRECTOR</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>StateOfCharge</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/StateOfCharge_I</PROVIDED-INTERFACE-TREF>
                </P-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>ChargeIntegral</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/ChargeIntegral_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>CellMeasurements</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/CellMeasurements_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>PackCurrent</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/PackCurrent_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SocStore</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Keeps the non-volatile shadow of the published state of charge.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_SOC_STORE</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>StateOfCharge</SHORT-NAME>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/StateOfCharge_I</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SohTracker</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Derives the remaining capacity from the charge counted between two rest anchors.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_SOH_TRACKER</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <P-PORT-PROTOTYPE>
                  <SHORT-NAME>RemainingCapacity</SHORT-NAME>
                  <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/BMS/PortInterfaces/RemainingCapacity_I</PROVIDED-INTERFACE-TREF>
