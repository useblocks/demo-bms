              </PORTS>
            </APPLICATION-SW-COMPONENT-TYPE>
            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>EstimationValidityMonitor</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Flags the estimate unreliable when the pack current is stale for 5 seconds.</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="useblocks.Traceability">
                    <SD GID="realizes">ARCH_ESTIMATION_VALIDITY_MONITOR</SD>
