# Copy to `docs/.env` (gitignored) and fill in. It sits beside `ubproject.toml`
# because that directory is the ubc project root — the working directory
# `ubc script` runs a script in. `tools/sync_alm.py` also accepts one at the
# repository root, or anywhere `ALM_ENV_FILE` points.
#
# Needed ONLY by `ubc script sync-jama`. The build never talks to Jama, because
# `docs/alm/needs.json` is committed — so a clone with no credentials still
# builds, it just cannot re-acquire.
#
# Jama Cloud API credentials are an OAuth client id + secret pair. Generate them
# in the Jama UI under your profile -> Set API Credentials. `oauth = true` in
# [ubconnect.from_jama] is what makes ubConnect send them that way.
#
# A variable already exported in the shell WINS over this file, so a CI secret is
# never clobbered by a stale local copy.

JAMA_USERNAME=<oauth client id>
JAMA_PASSWORD=<oauth client secret>
